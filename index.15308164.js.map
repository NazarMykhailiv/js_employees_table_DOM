var table = document.querySelector("table");
var tbody = table.querySelector("tbody");
document.addEventListener("DOMContentLoaded", function() {
    var parseCellValue = function parseCellValue(val) {
        if (val.startsWith("$")) return parseFloat(val.replace(/[^0-9.-]+/g, ""));
        if (!Number.isNaN(parseFloat(val))) return parseFloat(val);
        return val.toLowerCase();
    };
    var headers = table.querySelectorAll("th");
    var sortDirections = {};
    headers.forEach(function(header, colIndex) {
        sortDirections[colIndex] = "asc";
        header.addEventListener("click", function() {
            var rowsArray = Array.from(tbody.querySelectorAll("tr"));
            var direction = sortDirections[colIndex];
            var multiplier = direction === "asc" ? 1 : -1;
            rowsArray.sort(function(rowA, rowB) {
                var cellA = rowA.children[colIndex].textContent.trim();
                var cellB = rowB.children[colIndex].textContent.trim();
                var a = parseCellValue(cellA);
                var b = parseCellValue(cellB);
                if (a < b) return -1 * multiplier;
                if (a > b) return 1 * multiplier;
                return 0;
            });
            rowsArray.forEach(function(row) {
                return tbody.appendChild(row);
            });
            sortDirections[colIndex] = direction === "asc" ? "desc" : "asc";
        });
    });
});
var pushNotification = function(posTop, posRight, title, description, type) {
    var div = document.createElement("div");
    div.classList.add("notification", type);
    div.setAttribute("data-qa", "notification");
    var msgTitle = document.createElement("h2");
    msgTitle.classList.add("title");
    msgTitle.textContent = title;
    var msgDescription = document.createElement("p");
    msgDescription.textContent = description;
    div.appendChild(msgTitle);
    div.appendChild(msgDescription);
    div.style.position = "absolute";
    div.style.top = "".concat(posTop, "px");
    div.style.right = "".concat(posRight, "px");
    document.body.appendChild(div);
    setTimeout(function() {
        div.remove();
    }, 2000);
};
var form = document.createElement("form");
form.classList.add("new-employee-form");
var nameLabel = document.createElement("label");
nameLabel.textContent = "Name: ";
